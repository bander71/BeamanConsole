{
  "name": "beaman-console-server",
  "version": "0.1.0",
  "private": true,
  "description": "Node API for Beaman Console",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
