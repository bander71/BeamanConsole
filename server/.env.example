# Copy to .env and fill in your local Postgres password.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/beaman_console_dev
PORT=3001

# Sign-in (see "Sign-in and permissions" in server/README.md)
# Microsoft sign-in: from the Beaman Console app registration in Entra ID.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Where people open the app (Microsoft returns them to <APP_URL>/api/auth/callback).
APP_URL=http://localhost:5173
# Emails that become admins on their first Microsoft sign-in.
ADMIN_EMAILS=
# "Sign in as" any user, from this computer only. Turn off once Microsoft sign-in works.
AUTH_DEV_LOGIN=true
