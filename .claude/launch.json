{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=server/.env.preview", "server/src/index.ts"],
      "port": 3011
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_URL=http://localhost:3011&& npm --prefix client run dev -- --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
